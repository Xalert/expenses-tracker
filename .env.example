# Copy to .env.local (dev) or set in your container environment (docker-compose.yml `environment:`).
# Values below are the local-dev defaults; the Docker image's defaults are noted where they differ.

# PostgreSQL connection URL (postgres:// or postgresql://). Required in production; the app applies its migrations
# on start. Unset in development it falls back to the value below, i.e. the database `npm run db:up` starts
# (compose.dev.yaml) — which holds your real dev data. `npm run dev:demo` uses ...@localhost:5432/expenses_demo.
# In Docker Compose the app reaches the db service at host `db`; URL-encode special characters in the password.
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses

# Session cookie "secure" flag: auto (secure only when x-forwarded-proto is https) | true | false
# `true` breaks sign-in over plain HTTP (the browser drops the cookie); keep `auto` unless you know you need it.
COOKIE_SECURE=auto

# Set to false to close sign-ups once your accounts exist (/register then shows a "disabled" message).
ALLOW_REGISTRATION=true

# The Overview's "All in <currency>" view converts other currencies at the ECB reference rates (each day's rate
# for the month figures, the latest for the wallet total), requested from https://api.frankfurter.dev (no key). Set to false to make no outbound request.
EXCHANGE_RATES=true

# Port the server listens on.
PORT=3000

# Docker image only: listen address (the image sets 0.0.0.0).
# HOSTNAME=0.0.0.0

# Development only (`npm run dev`): extra hostnames allowed to open the dev server, comma-separated, without
# scheme or port — e.g. a tunnel or `*.lan`. `localhost` and this machine's own LAN addresses are always allowed.
# Without an entry, a page opened under another hostname renders but its buttons and forms do nothing.
# ALLOWED_DEV_ORIGINS=my-laptop.lan,*.tunnel.example.com

# Optional: where the SQL migrations live (default: <cwd>/drizzle; the image sets /app/drizzle).
# MIGRATIONS_DIR=drizzle
